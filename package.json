{
  "name": "the-jira-police",
  "version": "0.1.0",
  "private": true,
  "description": "Watches the SSX Jira board and auto-runs intake-triage on new tickets",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "poll:once": "node --env-file-if-exists=.env src/cli/poll-once.ts",
    "triage:once": "node --env-file-if-exists=.env src/cli/triage-once.ts",
    "solve:once": "node --env-file-if-exists=.env src/cli/solve-once.ts",
    "bot:once": "node --env-file-if-exists=.env src/cli/bot-once.ts",
    "watch:once": "node --env-file-if-exists=.env src/cli/watch-once.ts",
    "daemon:status": "node src/cli/daemon-status.ts",
    "check-types": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:hooks": ".claude/hooks/test-hooks.sh",
    "hooks:brief": "printf '{\"trigger\":\"compact\"}' | CLAUDE_PROJECT_DIR=\"$PWD\" .claude/hooks/session-brief.sh",
    "hooks:commit-brief": "CLAUDE_PROJECT_DIR=\"$PWD\" .claude/hooks/commit-brief.sh </dev/null | node -e 'let s=\"\";process.stdin.on(\"data\",(d)=>(s+=d)).on(\"end\",()=>process.stdout.write(JSON.parse(s).hookSpecificOutput.additionalContext+\"\\n\"))'",
    "docs:check": "node src/cli/docs-check.ts"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "typescript": "^5.9.2",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.20.0"
}
