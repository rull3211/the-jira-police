{
  "display_information": {
    "name": "Bencebot",
    "description": "The audit log of what the-jira-police does to each SSX ticket, one thread per ticket.",
    "background_color": "#2c2d30"
  },
  "features": {
    "bot_user": {
      "display_name": "Bencebot",
      "always_online": false
    },
    "slash_commands": [
      {
        "command": "/bencebot",
        "description": "Be mentioned on each major event of every ticket, or stop",
        "usage_hint": "[subscribe | unsubscribe]",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "channels:join",
        "channels:read",
        "chat:write",
        "commands",
        "files:read",
        "groups:history",
        "groups:read",
        "im:history",
        "mpim:history",
        "reactions:read",
        "reactions:write",
        "users:read",
        "users:read.email"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": ["app_mention"]
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false,
    "app_level_token_rotation_enabled": false
  }
}
