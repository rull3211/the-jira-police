  # --- Required ---
JIRA_EMAIL=
JIRA_AUTH=

  # --- Jira ---
  JIRA_BASE_URL=https://storebrand.atlassian.net
  JIRA_PROJECT=SSX
  # Components to watch, by name or id. The SSX board is shared, so this is what
  # keeps the service off other teams' tickets. Blank watches the whole board.
  JIRA_COMPONENTS=SSX Advisor
  # Issue type ids to skip. 10009 = Deloppgave (sub-tasks).
  JIRA_EXCLUDED_TYPES=10009

  # --- Polling ---
  POLL_INTERVAL_MS=300000
  # Re-scan window. Jira date filters are minute-precision, so a strict cursor
  # can miss issues created in the same minute; key-level dedupe absorbs the overlap.
  CURSOR_OVERLAP_MS=120000
  # Window when no state file exists. Short on purpose.
  FIRST_RUN_LOOKBACK_MINUTES=60

  # --- Triage ---
  # Defaults to the mock so an unconfigured service cannot post real verdicts.
  SKILL_NAME=mock-triage
  # Absolute path to the insurance-knowledge-vault clone. Required by any skill
  # other than the two stand-ins: without it intake-triage stops to ask a human,
  # which headless means exiting successfully having decided nothing.
  VAULT_PATH=
  # Post the verdict to the Jira issue itself: a comment, a label union, and an
  # issue link on a duplicate. Never a status transition — the tool for that is
  # withheld from the run, so it cannot happen even if asked. Off writes only the
  # local markdown. Only the exact string "true" enables it.
  # Try it on one ticket first: pnpm triage:once SSX-1234 --write
  WRITE_BACK=false
  STORECODE_PATH=storecode
  TRIAGE_TIMEOUT_MS=600000

  # --- Local paths ---
  STATE_PATH=state/poll.json
  OUTPUT_DIR=groomed
  LOG_LEVEL=info