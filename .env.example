  # --- Required ---
JIRA_EMAIL=
JIRA_AUTH=

  # --- Jira ---
  JIRA_BASE_URL=https://storebrand.atlassian.net
  JIRA_PROJECT=SSX
  # Issue type ids to skip. 10009 = Deloppgave (sub-tasks).
  JIRA_EXCLUDED_TYPES=10009

  # --- Polling ---
  POLL_INTERVAL_MS=300000
  # Re-scan window. Jira date filters are minute-precision, so a strict cursor
  # can miss issues created in the same minute; key-level dedupe absorbs the overlap.
  CURSOR_OVERLAP_MS=120000
  # Window when no state file exists. Short on purpose.
  FIRST_RUN_LOOKBACK_MINUTES=60

  # --- Triage ---
  # Defaults to the mock so an unconfigured service cannot post real verdicts.
  SKILL_NAME=mock-triage
  STORECODE_PATH=storecode
  TRIAGE_TIMEOUT_MS=600000

  # --- Local paths ---
  STATE_PATH=state/poll.json
  OUTPUT_DIR=groomed
  LOG_LEVEL=info