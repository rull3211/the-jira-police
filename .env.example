  # --- Required ---
JIRA_EMAIL=
JIRA_AUTH=
  # --- Jira ---
JIRA_BASE_URL=https://storebrand.atlassian.net
JIRA_PROJECT=SSX
  # Issue type ids to skip. 10009 = Deloppgave (sub-tasks).
JIRA_EXCLUDED_TYPES=10009

  # Statuses discovery may triage. Blank triages anything not closed. Not
  # expressible as a status category: "In Progress Concept" is `indeterminate`
  # and belongs here, "Prioritized" is `new` and does not. Blanking this does
  # not disable it — a blank reads as unset. To widen, list the ones you want.
  #
  # By ID, and that is not cosmetic: names are also accepted, but this default
  # used them until `status = "Mottatt"` was found to match zero issues while
  # `status = 10165` matched all 51. A name that does not resolve is a silent
  # hole, so check one against the board before using it.
  #   10165 Mottatt · 10025 Backlog · 10194 On Hold · 10179 In Progress Concept
TRIAGE_ONLY_STATUS=10165,10025,10194,10179

  # --- Polling ---
POLL_INTERVAL_MS=300000
JIRA_COMPONENTS=SSX Advisor
  # Re-scan window. Jira date filters are minute-precision, so a strict cursor
  # can miss issues created in the same minute; key-level dedupe absorbs the overlap.
CURSOR_OVERLAP_MS=120000
  # Window when no state file exists. Short on purpose.
FIRST_RUN_LOOKBACK_MINUTES=60
SOLVE_WORKTREE_ROOT=/Users/daniel.bence.soke/Documents/worktrees
  # --- Triage ---
  # Defaults to the mock so an unconfigured service cannot post real verdicts.
SKILL_NAME=intake-triage
VAULT_PATH=
STORECODE_PATH=storecode
TRIAGE_TIMEOUT_MS=600000

  # --- Local paths ---
STATE_PATH=state/poll.json
OUTPUT_DIR=groomed
LOG_LEVEL=info


SOLVE_ENABLED=true
SOLVE_MODE=manual                 # manual | auto
SOLVE_AUTO_ISSUE_TYPES=Feil       # auto mode only; this board's bug type, id preferred
SOLVE_REPOS=buy-insurance-advisor-web
MAX_CONCURRENT_SOLVES=1
MAX_REVIEW_ITERATIONS=3
SOLVE_GITHUB_OWNER=storebrand-digital
SOLVE_REPO_ROOT=
FAIL_FIRST_CHECK=true
SOLVE_READ_DIRS=insurance-ssx-mono-repo,insurance-commerce-rest-api,buy-insurance-advisor-web,buy-insurance-web,insurance-knowledge-vault
