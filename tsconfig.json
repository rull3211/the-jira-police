{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ESNext"],
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,

    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    // Node runs these files by stripping types, never compiling them. Without
    // this, tsc happily accepts enums, namespaces and parameter properties
    // that crash at runtime.
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "*.config.ts"],
  "exclude": ["node_modules", ".storecode", "groomed"]
}
